  * non-indexed 4-vertex strip (prim 6); without this it fell to the fixed-
  * function fallback with is_vp=0 (no vertex-program transform -> the quad
  * collapsed to a line) and textured=0 (the Y/U/V planes never sampled). */
+/* RSX splits one strip into DRAW_*ARRAY packets of <= 256 inside one BEGIN/END and the hardware joins them.
+ * Each packet used to become its own strip: the 2 triangles across every boundary were lost (holes in the
+ * rider/vehicle meshes). A packet that continues the previous one re-reads its last 2 vertices and keeps the
+ * winding parity. STRIP_NOCONT=1 = old behaviour. */
+static u32 s_strip_par = 0;
+static void strip_cont(int indexed, u32 prim, u32* first, u32* count)
+{
+    static u32 ep0 = ~0u, end0 = ~0u, start0 = 0, ixoff0 = 0; static int ix0 = -1, off = -1;
+    if (off < 0) off = getenv("STRIP_NOCONT") ? 1 : 0;
+    s_strip_par = 0;
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!st || prim != RSX_PRIMITIVE_TRIANGLE_STRIP) { end0 = ~0u; return; }
+    const u32 f = *first, c = *count, ep = st->begin_epoch;
+    if (!off && ep == ep0 && indexed == ix0 && f == end0 && f >= start0 + 2 &&
+        (!indexed || st->index_array_offset == ixoff0)) {
+        s_strip_par = (f - 2 - start0) & 1; *first = f - 2; *count = c + 2;
+    } else start0 = f;
+    ep0 = ep; ix0 = indexed; end0 = f + c; ixoff0 = st->index_array_offset;
+}
